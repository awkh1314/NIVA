{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NIVA",
  "version": "0.99.0",
  "identifier": "site.awkh.niva",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NIVA",
        "width": 440,
        "height": 720,
        "minWidth": 420,
        "minHeight": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
